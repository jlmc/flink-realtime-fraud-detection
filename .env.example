# LOCAL DEVELOPMENT DEFAULTS ONLY. Never reuse these credentials outside a developer machine.
# Copy to .env to override. In production inject secrets from a secret manager and use AWS S3 (no endpoint override).

POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_PORT=5432

KAFKA_PARTITIONS=6
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8080

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=flink-state
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

FLINK_UI_PORT=8081
FLINK_TASK_SLOTS=3
FLINK_PARALLELISM=3

# Where container data is persisted (bind mounts). Default: ./.data (git-ignored)
# DATA_DIR=./.data
